{
  "rules": {
    ".read": false,
    ".write": false,
    "orgs": {
      "$orgId": {
        "security": {
          ".read": "auth != null && root.child('orgs').child($orgId).child('admins').child(auth.uid).child('active').val() === true",
          ".write": "auth != null && root.child('orgs').child($orgId).child('admins').child(auth.uid).child('active').val() === true"
        },
        "admins": {
          "$uid": {
            ".read": "auth != null && (auth.uid === $uid || root.child('orgs').child($orgId).child('admins').child(auth.uid).child('active').val() === true)",
            ".write": "auth != null && (root.child('orgs').child($orgId).child('admins').child(auth.uid).child('active').val() === true || (auth.uid === $uid && newData.child('active').val() === true && newData.child('proof').val() === root.child('orgs').child($orgId).child('security').child('adminSecretHash').val()))"
          }
        },
        "appData": {
          ".read": "auth != null && root.child('orgs').child($orgId).child('admins').child(auth.uid).child('active').val() === true",
          ".write": "auth != null && root.child('orgs').child($orgId).child('admins').child(auth.uid).child('active').val() === true"
        },
        "locations": {
          ".read": "auth != null && root.child('orgs').child($orgId).child('admins').child(auth.uid).child('active').val() === true",
          "$uid": {
            ".write": "auth != null && (root.child('orgs').child($orgId).child('admins').child(auth.uid).child('active').val() === true || (auth.uid === $uid && root.child('orgs').child($orgId).child('driverAccess').child(auth.uid).child('active').val() === true && newData.child('driverId').val() === root.child('orgs').child($orgId).child('driverAccess').child(auth.uid).child('driverId').val()))"
          }
        },
        "registrationInvites": {
          "$token": {
            ".read": "auth != null",
            ".write": "auth != null && (root.child('orgs').child($orgId).child('admins').child(auth.uid).child('active').val() === true || (data.child('status').val() === 'open' && newData.child('status').val() === 'submitted' && root.child('orgs').child($orgId).child('registrations').child($token).child('parentUid').val() === auth.uid))"
          }
        },
        "registrations": {
          ".read": "auth != null && root.child('orgs').child($orgId).child('admins').child(auth.uid).child('active').val() === true",
          "$token": {
            ".read": "auth != null && data.child('parentUid').val() === auth.uid",
            ".write": "auth != null && (root.child('orgs').child($orgId).child('admins').child(auth.uid).child('active').val() === true || (root.child('orgs').child($orgId).child('registrationInvites').child($token).child('status').val() === 'open' && newData.child('parentUid').val() === auth.uid && newData.child('status').val() === 'pending'))"
          }
        },
        "parentAccess": {
          "$uid": {
            ".read": "auth != null && (auth.uid === $uid || root.child('orgs').child($orgId).child('admins').child(auth.uid).child('active').val() === true)",
            ".write": "auth != null && root.child('orgs').child($orgId).child('admins').child(auth.uid).child('active').val() === true"
          }
        },
        "parentViews": {
          "$uid": {
            ".read": "auth != null && (auth.uid === $uid || root.child('orgs').child($orgId).child('admins').child(auth.uid).child('active').val() === true)",
            ".write": "auth != null && root.child('orgs').child($orgId).child('admins').child(auth.uid).child('active').val() === true"
          }
        },
        "driverInvites": {
          "$token": {
            ".read": "auth != null",
            ".write": "auth != null && (root.child('orgs').child($orgId).child('admins').child(auth.uid).child('active').val() === true || (data.child('status').val() === 'open' && newData.child('status').val() === 'claimed' && newData.child('uid').val() === auth.uid && newData.child('driverId').val() === data.child('driverId').val()))"
          }
        },
        "driverAccess": {
          ".read": "auth != null && root.child('orgs').child($orgId).child('admins').child(auth.uid).child('active').val() === true",
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && (root.child('orgs').child($orgId).child('admins').child(auth.uid).child('active').val() === true || (auth.uid === $uid && newData.child('active').val() === true && root.child('orgs').child($orgId).child('driverInvites').child(newData.child('inviteToken').val()).child('status').val() === 'open' && newData.child('driverId').val() === root.child('orgs').child($orgId).child('driverInvites').child(newData.child('inviteToken').val()).child('driverId').val()))"
          }
        },
        "driverViews": {
          "$uid": {
            ".read": "auth != null && (auth.uid === $uid || root.child('orgs').child($orgId).child('admins').child(auth.uid).child('active').val() === true)",
            ".write": "auth != null && root.child('orgs').child($orgId).child('admins').child(auth.uid).child('active').val() === true"
          }
        },
        "driverOps": {
          ".read": "auth != null && root.child('orgs').child($orgId).child('admins').child(auth.uid).child('active').val() === true",
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && root.child('orgs').child($orgId).child('driverAccess').child(auth.uid).child('active').val() === true && newData.child('driverId').val() === root.child('orgs').child($orgId).child('driverAccess').child(auth.uid).child('driverId').val()"
          }
        }
      }
    }
  }
}